{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with verified authentication credentials, role, points and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase user ID" },
        "displayName": { "type": "string", "maxLength": 100, "description": "User's full display name" },
        "email": { "type": "string", "format": "email", "maxLength": 150, "description": "User email address" },
        "photoURL": { "type": "string", "maxLength": 500, "description": "Avatar URL" },
        "authProvider": { "type": "string", "enum": ["google", "password", "guest"], "description": "Authentication method" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "lastLoginAt": { "type": "string", "description": "Latest login timestamp" },
        "totalPoints": { "type": "number", "description": "Validated cumulative learning points" },
        "preferredLanguage": { "type": "string", "enum": ["en", "mr", "hi"], "description": "Explanation language" },
        "level": { "type": "string", "enum": ["beginner", "intermediate", "advanced"], "description": "Kannada proficiency level" }
      },
      "required": ["uid", "displayName", "email", "createdAt", "totalPoints"]
    },
    "UserProgress": {
      "title": "User Progress",
      "description": "Track completed lessons, quizzes, learning streaks, and metrics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owning user UID" },
        "completedLessonIds": { "type": "array", "description": "List of completed lesson IDs" },
        "quizScores": { "type": "array", "description": "Array of quiz scores" },
        "streakDays": { "type": "number", "description": "Consecutive days active" },
        "lastActiveDate": { "type": "string", "description": "Last active ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Record update timestamp" }
      },
      "required": ["userId", "completedLessonIds", "quizScores", "streakDays"]
    },
    "SavedVocabulary": {
      "title": "Saved Vocabulary",
      "description": "Personalized saved Kannada vocabulary items for spaced review",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owning user UID" },
        "savedWordIds": { "type": "array", "description": "List of vocabulary word IDs" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["userId", "savedWordIds"]
    },
    "PointTransaction": {
      "title": "Point Transaction",
      "description": "Validated point award ledger entry preventing duplicate point awards",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Transaction ID" },
        "userId": { "type": "string", "description": "User UID who earned points" },
        "activityId": { "type": "string", "maxLength": 100, "description": "Activity ID e.g. lesson or quiz ID" },
        "type": { "type": "string", "enum": ["lesson", "quiz", "roleplay", "vocabulary", "pronunciation"], "description": "Activity category" },
        "pointsEarned": { "type": "number", "description": "Points awarded for this activity" },
        "title": { "type": "string", "maxLength": 200, "description": "Human-readable activity summary" },
        "timestamp": { "type": "string", "description": "When the points were awarded" }
      },
      "required": ["id", "userId", "activityId", "type", "pointsEarned", "timestamp"]
    },
    "UserBadges": {
      "title": "User Badges",
      "description": "Earned badge achievement state synchronized with totalPoints",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owning user UID" },
        "unlockedBadgeIds": { "type": "array", "description": "Array of unlocked badge IDs" },
        "badges": { "type": "array", "description": "Array of badge details with unlock timestamps" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["userId", "unlockedBadgeIds"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "#/entities/User",
      "description": "User profile records. User can only read and write their own document matching auth.uid."
    },
    "/userProgress/{uid}": {
      "schema": "#/entities/UserProgress",
      "description": "Personal learning progress. User can only read and write their own document matching auth.uid."
    },
    "/savedVocabulary/{uid}": {
      "schema": "#/entities/SavedVocabulary",
      "description": "Personal saved vocabulary. User can only read and write their own document matching auth.uid."
    },
    "/pointTransactions/{transactionId}": {
      "schema": "#/entities/PointTransaction",
      "description": "Audited point ledger transactions. User can read their transactions and record valid awards."
    },
    "/userBadges/{uid}": {
      "schema": "#/entities/UserBadges",
      "description": "Earned badge achievements. User can read and update their own earned badges matching auth.uid."
    }
  }
}
