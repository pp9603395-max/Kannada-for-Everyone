# ---------------------------------------------------------------------------
# Kannada for Everyone — environment variables
# Copy to .env and fill in only the values you need.
# ---------------------------------------------------------------------------

# HTTP port used by the Express server (default: 3000)
PORT=3000

# "production" serves the prebuilt dist/ bundle. `npm start` sets this for you.
NODE_ENV=development

# Optional: Gemini API key for AI roleplay. Without it the app uses friendly
# pedagogical fallback replies, so lessons and quizzes still work.
GEMINI_API_KEY=

# Firebase Admin credentials.
# Option A (recommended on GCP / Cloud Run): attach a service account with
# "Cloud Datastore User" + "Firebase Authentication Admin" and use ADC.
# Option B: paste the full service-account JSON as a single-line string.
# Never commit the real service-account JSON.
FIREBASE_SERVICE_ACCOUNT=

# Optional: override the Firebase project / named Firestore database.
# Client-side config lives in firebase-applet-config.json.
# FIREBASE_PROJECT_ID=
# FIREBASE_FIRESTORE_DATABASE_ID=
